# Allowlist excludes documents, models, TLS keys, credentials, and local caches.
**
!backend/
!backend/Dockerfile
!backend/requirements*.txt
!backend/app/
!backend/app/**
!frontend/
!frontend/Dockerfile
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.js
!frontend/nginx.conf
!frontend/src/
!frontend/src/**
**/__pycache__/
**/*.pyc
**/node_modules/
**/dist/
**/.smoke*/
**/*.log
**/.env*
**/.git/
**/.aws/
**/.codex/
**/.agents/
**/*.key
**/*.pem
**/id_ed25519*
