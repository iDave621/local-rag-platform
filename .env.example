APP_ENV=production
COOKIE_SECURE=true
SESSION_TIMEOUT_SECONDS=900
CHAT_RETENTION_DAYS=7
CHAT_RESULT_TIMEOUT_SECONDS=240
TECHNICIAN_RATE_LIMIT_PER_MINUTE=12
TECHNICIAN_MAX_MESSAGE_CHARS=4000
ADMIN_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_ACCOUNT_RATE_LIMIT_PER_MINUTE=20

POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-this-database-password
REDIS_PASSWORD=change-this-redis-password
# init-config.sh generates random values. Compose assembles database/Redis URLs.
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=technical_kb
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=change-this-chroma-token
CHROMA_CA_FILE=
DATA_ROOT=/data
HOST_DATA_PATH=./data
OLLAMA_HOST_PATH=./data/ollama

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=1024
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NO_CLOUD=1
APP_MAX_INFLIGHT_GENERATIONS=1
RETRIEVAL_TOP_K=6
RELEVANCE_THRESHOLD=0.20
MAX_HISTORY_MESSAGES=6
RAG_OUTPUT_TOKEN_BUDGET=768
RAG_PROMPT_TOKEN_BUDGET=0
RAG_HISTORY_TOKEN_BUDGET=600
VISION_ENABLED=false
VISION_MAX_IMAGES_PER_DOCUMENT=100
VISION_MAX_IMAGE_BYTES=12582912
VISION_MAX_DIMENSION=1800
VISION_MIN_WIDTH=96
VISION_MIN_HEIGHT=96
VISION_REQUEST_TIMEOUT_SECONDS=180

LITERATURE_SITE_URL=
LITERATURE_SYNC_INTERVAL_SECONDS=900
LITERATURE_REQUEST_TIMEOUT_SECONDS=45
LITERATURE_CRAWL_MAX_PAGES=1000
LITERATURE_VERIFY_TLS=true
LITERATURE_AUTH_HEADER=
LITERATURE_AUTH_VALUE=

ADMIN_UPLOAD_MAX_BYTES=26214400
ADMIN_DOCX_MAX_UNCOMPRESSED_BYTES=209715200
QUEUE_RESULT_TTL_SECONDS=86400
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_RETENTION_DAYS=30
WORKER_HEALTH_TIMEOUT_SECONDS=150
INGEST_CHUNK_SIZE=1000
INGEST_CHUNK_OVERLAP=150
OCR_ENABLED=true
OCR_LANGUAGES=eng+heb
OCR_TIMEOUT_SECONDS=120
OCR_PDF_DPI=200
OCR_MIN_TEXT_CHARS=24
LEGACY_DOC_CONVERSION_TIMEOUT_SECONDS=120
ADMIN_PDF_MAX_PAGES=1000
HTTPS_PORT=443
HTTP_REDIRECT_PORT=80
WEB_BIND_ADDRESS=0.0.0.0
TLS_CERT_PATH=./deploy/tls
# Only for the explicit deploy/compose/local-http.yml loopback override:
LOCAL_HTTP_PORT=8088
# Optional two-server deployment requires explicit absolute paths and remote addresses:
REMOTE_DATABASE_URL=
REMOTE_CHROMA_HOST=
REMOTE_CHROMA_PORT=8443
DATA_BIND_ADDRESS=
DATA_CA_PATH=
DATA_TLS_PATH=
